+  // Scroll reveals, re-scanned after each route change.
+  useEffect(() => {
+    const items = () => document.querySelectorAll('[data-reveal]:not(.is-in)')
+    if (reduceMotion() || !('IntersectionObserver' in window)) {
+      items().forEach(el => el.classList.add('is-in'))
